# Generated output
build/
**/build/
node_modules/
__pycache__/
*.py[cod]
*.o
*.elf
*.a
*.bin.tmp
*.log
tests/preview/out/
tests/preview/out-nro/
release/

# Local state and external checkouts
.env
.env.*
!.env.example
*.local.json
run/
runs/
runs/latest/
saves/
reference/

# NRO companion build artifacts are ignored under its local .gitignore.

# User-installed web apps. Keep only the safe demonstration app in source archives.
web-apps/*
!web-apps/hello-node/
!web-apps/hello-node/**
!web-apps/hello-vite/
!web-apps/hello-vite/**
web-apps/*/node_modules/
web-apps/*/dist/

# App payloads and user-supplied media
payloads/
nros/
data/nro-profiles/
apps/*/code.bin
apps/*/data.bin
apps/*/assets/
*.nes
*.z64
*.nsp
*.xci
*.wad
*.iso
*.nds
*.keys
