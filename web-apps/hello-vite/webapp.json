{
  "format": "brendan.webapp",
  "apiVersion": 1,
  "id": "hello-vite",
  "name": "Hello TypeScript web app",
  "version": "1.0.0",
  "description": "A Vite-built TypeScript app delivered as plain HTML, CSS, and JavaScript.",
  "runtime": "static",
  "distDir": "dist",
  "spa": true,
  "path": "/",
  "build": {
    "tool": "vite",
    "entry": "index.html",
    "outDir": "dist"
  },
  "nativePort": {
    "enabled": true,
    "version": 1,
    "actions": ["counter"]
  }
}
