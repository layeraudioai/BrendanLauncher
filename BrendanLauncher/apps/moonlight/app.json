{
  "format": "hblauncher.gpu-app",
  "abi": 1,
  "id": "moonlight",
  "name": "Moonlight",
  "version": "1.0.0",
  "description": "Stream a Sunshine PC to Switch 2 through the BrendanLauncher bridge",
  "icon": "assets/icon.png",
  "initialState": "assets/state.bin",
  "data": "assets/text.bin",
  "shaders": {
    "vertex": "app.vert.spv",
    "fragment": "app.frag.spv",
    "compute": "app.comp.spv"
