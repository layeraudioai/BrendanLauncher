  "sdk": {
    "version": 1,
    "capabilities": [],
    "services": []
  },
  "audio": {
    "sampleRate": 48000,
    "channels": 2,
    "format": "s16le",
    "effects": {
      "1": "assets/audio_1.pcm",
      "2": "assets/audio_2.pcm",
      "9": "assets/audio_9.pcm",
      "10": "assets/audio_10.pcm",
      "11": "assets/audio_11.pcm",
      "12": "assets/audio_12.pcm",
      "13": "assets/audio_13.pcm",
      "14": "assets/audio_14.pcm"
    },
    "stream": [
      9,
      10,
      11,
      12,
      13,
      14
    ]
  }
