{
  "format": "hblauncher.gpu-app",
  "abi": 1,
  "id": "media-machine",
  "name": "Media Machine",
  "version": "1.1.0",
  "description": "Local audio and video player for BrendanLauncher",
  "transition": "fade",
  "shaders": {
    "vertex": "app.vert.spv",
    "fragment": "app.frag.spv",
    "compute": "app.comp.spv"
  },
  "initialState": "assets/state.bin",
  "data": "assets/text.bin",
  "icon": "assets/icon.png",
  "audio": {
    "sampleRate": 48000,
    "channels": 2,
    "format": "s16le",
    "effects": {
      "1": "assets/audio_1.pcm"
    }
  }
}
